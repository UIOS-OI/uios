# Local inference through Ollama's native API (default, DECISIONS.md D-02/D-11)
UIOS_OLLAMA_URL=http://127.0.0.1:11434
UIOS_OLLAMA_CHAT_MODEL=qwen3.5:2b
UIOS_OLLAMA_EMBED_MODEL=nomic-embed-text
UIOS_OLLAMA_NUM_CTX=8192
UIOS_OLLAMA_KEEP_ALIVE=10m
UIOS_OLLAMA_TIMEOUT_MS=120000

# Routing policy: local-only | consent (default: cloud only with per-request consent and disclosure)
#                 | cloud-allowed (operator pre-authorizes configured remote providers)
UIOS_ROUTING_POLICY=consent

# Intelligence store (trace events now; resources and memory in later stages).
# Defaults to <UIOS_STATE_DB name>.intelligence.sqlite next to the state database.
UIOS_INTELLIGENCE_DB=
UIOS_TRACE_RETENTION_DAYS=30

# Optional OpenAI-compatible gateway (remote unless UIOS_AI_GATEWAY_LOCALITY=local)
UIOS_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
UIOS_AI_GATEWAY_KEY=
UIOS_DEFAULT_MODEL=
UIOS_AI_GATEWAY_LOCALITY=remote
# Embedding model id for the gateway (used only when no local embedder exists and policy is cloud-allowed)
UIOS_EMBEDDING_MODEL=
UIOS_ROUTING_STRATEGY=explicit
UIOS_FALLBACK_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
UIOS_FALLBACK_GATEWAY_KEY=
UIOS_FALLBACK_DEFAULT_MODEL=

# Built-in Aegis security plane
UIOS_AEGIS_URL=
UIOS_AEGIS_KEY=
UIOS_AEGIS_REQUIRED=false
UIOS_AEGIS_FAIL_CLOSED=true

# Workspace metering
UIOS_WORKSPACE_SECRET=replace-with-a-long-random-secret
UIOS_PLAN_LIMIT_UNITS=1000
UIOS_SCALE_PLAN_LIMIT_UNITS=25000
UIOS_ENTERPRISE_PLAN_LIMIT_UNITS=10000000
UIOS_RATE_LIMIT_PER_MINUTE=30
UIOS_STATE_FILE=.uios-data/state.json
UIOS_STATE_DB=.uios-data/uios.sqlite
UIOS_AUDIT_RETENTION_DAYS=365

# Stripe monetization
STRIPE_SECRET_KEY=
STRIPE_PRICE_SCALE=
STRIPE_WEBHOOK_SECRET=

# Public security disclosure metadata
UIOS_SECURITY_CONTACT=mailto:security@yourdomain.example
UIOS_SECURITY_POLICY_URL=/security

# GitHub connector (Stage 2): fine-grained, read-only personal access token
UIOS_GITHUB_TOKEN=
