{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["es2023", "dom"],
    "baseUrl": ".",
    "paths": {
      "@uios/contracts": ["packages/contracts/src/index.ts"],
      "@uios/trace": ["services/trace/src/index.ts"],
      "@uios/router": ["services/router/src/index.ts"]
    }
  },
  "include": ["packages/contracts/src/**/*.ts", "services/*/src/**/*.ts", "tests/unit/**/*.ts"]
}
